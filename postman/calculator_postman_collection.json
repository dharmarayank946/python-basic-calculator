{
  "info": {
    "_postman_id": "calculator-pro-api-v1",
    "name": "Calculator Pro API",
    "description": "Postman Collection for Calculator Pro FastAPI backend deployed on Render.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness probe for Render deployment."
      },
      "response": [
        {
          "name": "Health Check - Success",
          "originalRequest": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "status": "OK",
          "code": 200,
          "body": "{\"status\":\"healthy\",\"service\":\"calculator-pro-api\",\"version\":\"1.0.0\"}"
        }
      ]
    },
    {
      "name": "Evaluate Expression",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expression\": \"(25 + 75) * 4 / 2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/calculator/evaluate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "calculator", "evaluate"]
        },
        "description": "Safe AST expression evaluation (zero eval)."
      },
      "response": [
        {
          "name": "Evaluate - Success",
          "originalRequest": {
            "method": "POST",
            "body": "{\"expression\": \"(25 + 75) * 4 / 2\"}"
          },
          "status": "OK",
          "code": 200,
          "body": "{\"expression\":\"(25 + 75) * 4 / 2\",\"result\":200.0,\"formatted\":\"200\"}"
        },
        {
          "name": "Evaluate - Division by Zero",
          "originalRequest": {
            "method": "POST",
            "body": "{\"expression\": \"50 / 0\"}"
          },
          "status": "Bad Request",
          "code": 400,
          "body": "{\"detail\":\"Cannot divide by zero.\"}"
        }
      ]
    },
    {
      "name": "Single Function Operation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"sqrt\",\n  \"value\": 144\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/calculator/function",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "calculator", "function"]
        },
        "description": "Perform single math function like sqrt, square, recip, negate, percent."
      },
      "response": [
        {
          "name": "Function - Sqrt Success",
          "status": "OK",
          "code": 200,
          "body": "{\"operation\":\"sqrt\",\"input\":144.0,\"result\":12.0,\"formatted\":\"12\"}"
        }
      ]
    },
    {
      "name": "Get Session History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/calculator/history",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "calculator", "history"]
        },
        "description": "Retrieve recent calculation log."
      },
      "response": [
        {
          "name": "History - Success",
          "status": "OK",
          "code": 200,
          "body": "{\"history\":[{\"expression\":\"(25 + 75) * 4 / 2\",\"result\":200.0,\"formatted\":\"200\",\"timestamp\":\"2026-10-26T21:30:00Z\"}]}"
        }
      ]
    }
  ]
}
